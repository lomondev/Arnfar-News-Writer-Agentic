# Copy to tools/.env and fill in. NEVER commit tools/.env.
# See tools/FACEBOOK_SETUP.md for how to obtain each value.

# The Arnfar Facebook Page
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Only needed to run `python3 tools/fb_post.py token`
FB_APP_ID=
FB_APP_SECRET=

# Optional — pin the Graph API version
FB_GRAPH_VERSION=v23.0
