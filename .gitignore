# === Secrets — never commit ===
.env
*.env
!*.env.example
tools/.env

# === macOS junk ===
.DS_Store
**/.DS_Store

# === Python ===
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# === Large font source/export files (exceed GitHub's 100MB limit) ===
# Keep only the .ttf files needed by the rendering pipeline.
font/*.svg
font/*.birdfont
font/*.eot

# === Temp / scratch ===
*.tmp
*.log

# === Images, video, audio — generated media stays local, never pushed ===
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.heic
*.psd
*.svg
*.ico
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.m4v
*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.flac
audio/
output/videos/
# Exception: brand logos the card renderers load at runtime
!arnfar-icon/*.png
